{
  "version": 2,
  "framework": null,
  "installCommand": "npm --prefix website install",
  "buildCommand": "npm --prefix website run build",
  "outputDirectory": "website/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(curl|Wget|HTTPie|fetch).*"
        }
      ],
      "destination": "https://raw.githubusercontent.com/phasehumans/spacetime/main/install.sh",
      "permanent": false
    },
    {
      "source": "/install.sh",
      "destination": "https://raw.githubusercontent.com/phasehumans/spacetime/main/install.sh",
      "permanent": false
    }
  ]
}
